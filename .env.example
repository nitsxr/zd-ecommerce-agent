# Multi-Agent E-commerce Assistant — environment example
# Copy to .env and adjust. docker-compose sets REDIS_URL for the api service.

# Session store: Redis URL. If unset, API uses in-memory store (single instance only).
REDIS_URL=redis://localhost:6379/0

# Session key TTL in seconds (default 86400 = 24h).
REDIS_SESSION_TTL_SECONDS=86400

# LLM orchestrator (Plan-LLM.md). When true, use LLM for intent/slots/clarification.
USE_LLM_ORCHESTRATOR=false

# Mock OpenAI calls (no API key needed). When true, LLM path uses keyword-based mock.
MOCK_LLM=true

# OpenAI (used only when USE_LLM_ORCHESTRATOR=true and MOCK_LLM=false).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
