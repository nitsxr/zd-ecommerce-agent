{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecommerce-assistant/schemas/trace_event.json",
  "title": "TraceEvent",
  "description": "Turn-level observability event. Stored separately from conversation state; no PII by default.",
  "type": "object",
  "required": ["request_id", "session_id", "turn_index", "timestamp", "intent", "selected_agent"],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Unique identifier for this request"
    },
    "session_id": {
      "type": "string",
      "description": "Session key (no PII)"
    },
    "turn_index": {
      "type": "integer",
      "description": "Zero-based index of this turn in the session",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp when the turn was processed"
    },
    "intent": {
      "type": "string",
      "description": "Detected intent",
      "enum": ["cancel", "track", "product", "unclear"]
    },
    "selected_agent": {
      "type": "string",
      "description": "Agent that handled this turn",
      "enum": ["OrderCancellationAgent", "OrderTrackingAgent", "ProductInfoAgent", "OrchestratorAgent"]
    },
    "tool_calls_summary": {
      "type": "array",
      "description": "Summary of tool invocations (tool name, success/failure)",
      "items": {
        "type": "object",
        "properties": {
          "tool": { "type": "string" },
          "success": { "type": "boolean" }
        }
      }
    },
    "latency_ms": {
      "type": "number",
      "description": "Processing latency for this turn in milliseconds"
    },
    "errors": {
      "type": "array",
      "description": "Errors encountered during this turn",
      "items": { "type": "string" }
    }
  }
}
